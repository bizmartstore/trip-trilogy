# Public Supabase URL
NEXORA_SUPABASE_URL=https://aeynekfhnzjcimskwouw.supabase.co
SUPABASE_URL=https://aeynekfhnzjcimskwouw.supabase.co
VITE_SUPABASE_URL=https://aeynekfhnzjcimskwouw.supabase.co

# Required on every host (local + Cloudflare Worker)
# so sign-up / sign-in persist in Supabase and work across devices.
# Use the service_role key from Supabase → Project Settings → API.
# Never expose this to the browser (no VITE_ prefix).
#
# Local: copy to `.dev.vars`
# Cloudflare (manual): wrangler secret put NEXORA_SUPABASE_SERVICE_ROLE_KEY
# Cloudflare (CI): add NEXORA_SUPABASE_SERVICE_ROLE_KEY to GitHub Actions secrets
NEXORA_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Google Web client ID (same value as Supabase → Authentication → Providers → Google).
# Also set as a Cloudflare Worker secret / GitHub Actions secret:
#   wrangler secret put GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# OneSignal Web Push (App ID is public; REST API Key stays secret).
# Dashboard → Settings → Keys & IDs
#   wrangler secret put ONESIGNAL_REST_API_KEY
ONESIGNAL_APP_ID=4efad5e2-6b5d-4691-86e4-618ea8c97493
VITE_ONESIGNAL_APP_ID=4efad5e2-6b5d-4691-86e4-618ea8c97493
ONESIGNAL_REST_API_KEY=

# Telegram admin group alerts. Never expose bot token to the browser.
#   wrangler secret put TELEGRAM_BOT_TOKEN
#   wrangler secret put TELEGRAM_CHAT_ID           # new + rejected
#   wrangler secret put TELEGRAM_APPROVED_CHAT_ID  # NEXORA APPROVED BOOKINGS
#   wrangler secret put TELEGRAM_REMINDER_CHAT_ID  # NEXORA BOOKING REMINDERS (−5530536297)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVED_CHAT_ID=
TELEGRAM_REMINDER_CHAT_ID=-5530536297
