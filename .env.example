# Public Supabase URL
NEXORA_SUPABASE_URL=https://aeynekfhnzjcimskwouw.supabase.co
SUPABASE_URL=https://aeynekfhnzjcimskwouw.supabase.co
VITE_SUPABASE_URL=https://aeynekfhnzjcimskwouw.supabase.co

# Required on every host (local + Cloudflare Worker)
# so sign-up / sign-in persist in Supabase and work across devices.
# Use the service_role key from Supabase → Project Settings → API.
# Never expose this to the browser (no VITE_ prefix).
#
# Local: copy to `.dev.vars`
# Cloudflare (manual): wrangler secret put NEXORA_SUPABASE_SERVICE_ROLE_KEY
# Cloudflare (CI): add NEXORA_SUPABASE_SERVICE_ROLE_KEY to GitHub Actions secrets
NEXORA_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_OAUTH_CLIENT_ID=
